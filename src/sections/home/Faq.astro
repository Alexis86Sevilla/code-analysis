---
const faqs = [
  {
    question: "¿Por qué hiciste esto?",
    answer: "Empecé este proyecto para entender cómo funciona la API de GitHub por dentro y para probar Astro en un entorno real. Es mi 'patio de juegos' técnico: quería algo funcional, bien estructurado y que se viera moderno."
  },
  {
    question: "¿Qué me llevo de esto?",
    answer: "Fue mi proceso de aprendizaje intensivo. Cada sección es el resultado de ir probando, equivocándome y refactorizando hasta que el código quedó como a mí me gusta. Si aprendí algo, lo apliqué acá."
  },
  {
    question: "¿Es un producto final?",
    answer: "No. Es un proyecto de aprendizaje. Lo uso para poner en práctica mis ideas de diseño y arquitectura. Cumple su función y me sirve para mostrar cómo trabajo."
  }
];
---
<section class="py-20 bg-slate-950" id="faq-section">
    <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-3xl font-bold text-center mb-12 text-white">Preguntas Frecuentes</h2>

        <div class="space-y-4">
            {faqs.map((faq, index) => (
                <div class="faq-item bg-transparent rounded-2xl border border-white/5 hover:border-white/10 transition-all duration-300">
                    <button class="cursor-pointer w-full text-left px-8 py-6 flex justify-between items-center gap-4 text-white hover:bg-white/5 transition-colors rounded-2xl"
                            data-faq={index + 1}>
                        <span class="font-semibold text-lg">{faq.question}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5"
                             stroke="currentColor"
                             class="size-5 text-slate-400 flex-shrink-0 transition-transform duration-300">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                        </svg>
                    </button>
                    <p class="hidden faq-answer px-8 pb-6 text-slate-400 leading-relaxed">
                        {faq.answer}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
  const faqSection = document.getElementById('faq-section');
  if (faqSection) {
    const faqItems = faqSection.querySelectorAll(".faq-item");
    const faqAnswers = faqSection.querySelectorAll(".faq-answer");
    const allChevrons = faqSection.querySelectorAll(".faq-item svg");
  
    faqItems.forEach((item) => {
      item.addEventListener("click", () => {
        const answer = item.querySelector(".faq-answer");
        const chevron = item.querySelector("svg");
        const wasOpen = !answer!.classList.contains("hidden");
  
        faqAnswers.forEach((a) => a.classList.add("hidden"));
        allChevrons.forEach((c) => c!.classList.remove("rotate-180"));
  
        if (!wasOpen) {
          answer!.classList.remove("hidden");
          chevron!.classList.add("transition-all", "rotate-180");
        } else {
          answer!.classList.add("hidden");
          chevron!.classList.remove("rotate-180");
        }
      });
    });
  }
</script>
