---

---

<form
  id="formData"
  class="relative bg-slate-900/50 backdrop-blur-md p-8 rounded-3xl border border-white/10 max-w-md w-full mx-auto shadow-2xl overflow-hidden"
>
  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-[#F14A00]/50 to-transparent"
  >
  </div>

  <div class="mb-8">
    <h3 class="text-xl font-bold text-white mb-2">Analizar Repositorio</h3>
    <p class="text-slate-400 text-sm">
      Ingresa los datos para obtener las métricas.
    </p>
  </div>

  <div class="mb-6">
    <label class="block text-slate-300 text-sm font-medium mb-2" for="user"
      >Usuario</label
    >
    <input
      id="user"
      name="user"
      type="text"
      class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-600 focus:outline-none focus:border-[#F14A00] focus:ring-1 focus:ring-[#F14A00] transition-all"
      placeholder="ejemplo: microsoft"
      required
    />
  </div>

  <div class="mb-8">
    <label
      class="block text-slate-300 text-sm font-medium mb-2"
      for="repository">Repositorio</label
    >
    <input
      id="repository"
      name="repository"
      type="text"
      class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white placeholder-slate-600 focus:outline-none focus:border-[#F14A00] focus:ring-1 focus:ring-[#F14A00] transition-all"
      placeholder="ejemplo: vscode"
      required
    />
  </div>

  <button
    id="submit-button"
    type="submit"
    class="w-full bg-[#F14A00] text-white font-bold py-3 px-6 rounded-xl hover:bg-[#D94200] transition-all duration-300 hover:shadow-lg hover:shadow-[#F14A00]/20 disabled:opacity-50 disabled:cursor-not-allowed"
  >
    <span id="button-text">Analizar Repositorio</span>
  </button>
</form>
