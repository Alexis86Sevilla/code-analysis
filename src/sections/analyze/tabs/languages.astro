---
const {class: className} = Astro.props;
---

<div class={className}>
    <h2 class="text-white text-center text-3xl mt-12 mb-12 font-bold tracking-tight">
        Distribución de lenguajes
    </h2>
    <div class="w-full max-w-4xl mx-auto p-8 bg-slate-900/50 backdrop-blur-md rounded-3xl border border-white/5" style="height: 400px;">
        <canvas id="languages-chart"></canvas>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>