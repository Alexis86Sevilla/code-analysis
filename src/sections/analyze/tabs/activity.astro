---
const { class: className } = Astro.props;
---

<div class={className + " w-full"}>
  <h2 class="text-white text-center text-3xl mt-12 mb-12 font-bold tracking-tight">
    Actividad
  </h2>
  <div
    id="activity-container"
    class="w-full max-w-5xl mx-auto p-8 bg-slate-900/50 backdrop-blur-md rounded-3xl border border-white/5 relative"
    style="height: 400px;"
  >
    <canvas id="activity-chart"></canvas>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"
></script>
